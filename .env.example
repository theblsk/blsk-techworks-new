# EmailJS Configuration
NEXT_PUBLIC_EMAIL_SERVICE_ID=your_service_id_here
NEXT_PUBLIC_EMAIL_TEMPLATE_ID=your_template_id_here
NEXT_PUBLIC_EMAIL_PUBLIC_KEY=your_public_key_here

# Umami Analytics (self-hosted on Railway)
#
# Railway setup (separate project from this website):
# 1. New Project → Deploy from template → Umami (or deploy umami-software/umami)
# 2. Add PostgreSQL → link DATABASE_URL to the Umami service
# 3. Set on Umami service: DATABASE_TYPE=postgresql, APP_SECRET=<random-secret>, HOSTNAME=0.0.0.0
# 4. Open Umami URL, log in (default admin/umami), change password, add this website
# 5. Copy the website ID and script URL from Settings → Tracking code
# 6. Set the variables below on this website's Railway service, then redeploy
#
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-umami.up.railway.app/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your_website_id_here
# Optional: restrict tracking to production domain only (comma-separated)
# NEXT_PUBLIC_UMAMI_DOMAINS=blsk.dev
